# Configuration Docker Compose (Option 3 : XAMPP MySQL + Docker MySQL)
# XAMPP MySQL sur port 3306 (pour d'autres projets)
# Docker MySQL sur port 3308 (pour LogSystem)

NODE_ENV=development
PORT=10000

# MySQL Docker (service interne Docker)
DB_HOST=mysql
DB_PORT=3306
DB_USER=logsystem
DB_PASSWORD=LogSystem2024!
DB_NAME=logsystem
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_KEEPALIVE=true

# Redis Docker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=LogSystemRedis2024!

# Sécurité
SESSION_SECRET=LogSystemSessionSecret2024ChangeThisToSomethingMoreSecure!
CSRF_SECRET=LogSystemCSRFSecret2024ChangeThisToSomethingMoreSecure!

# Application
RUN_MIGRATIONS_ON_START=true
START_BACKGROUND_JOBS=true
WATCH_DIR_USER_MAP=/app/logs:1

# MySQL Docker variables (port exposé sur l'hôte)
MYSQL_ROOT_PASSWORD=LogSystem2024!
MYSQL_DATABASE=logsystem
MYSQL_USER=logsystem
MYSQL_PASSWORD=LogSystem2024!
MYSQL_ROOT_HOST=%
MYSQL_HOST_PORT=3308
