# ═════════════════════════════════════════════════════════════════════════════
# LogSystem - Configuration Production Docker Compose
# ═════════════════════════════════════════════════════════════════════════════
#
# ⚠️ IMPORTANT: Copiez ce fichier en .env.production et remplacez toutes les valeurs
# par des mots de passe forts et uniques avant tout déploiement en production.
#
# Génération de secrets sécurisés:
# - Linux/Mac: openssl rand -base64 32
# - Windows: openssl rand -base64 32 (via Git Bash ou OpenSSL)
#
# ═════════════════════════════════════════════════════════════════════════════

# ── APPLICATION ───────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000

# ── MYSQL PRODUCTION ───────────────────────────────────────────────────────────
# IMPORTANT: Changez ces mots de passe par des valeurs fortes et uniques
MYSQL_ROOT_PASSWORD=CHANGE_THIS_STRONG_ROOT_PASSWORD_MIN_32_CHARS
MYSQL_DATABASE=logsystem
MYSQL_USER=logsystem
MYSQL_PASSWORD=CHANGE_THIS_STRONG_APP_PASSWORD_MIN_32_CHARS
MYSQL_ROOT_HOST=%
# Port exposé sur l'hôte (3308 pour éviter conflit avec XAMPP MySQL sur 3306)
MYSQL_HOST_PORT=3308

# ── REDIS PRODUCTION ───────────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD_MIN_32_CHARS

# ── SÉCURITÉ APPLICATION ───────────────────────────────────────────────────────
# IMPORTANT: Ces secrets doivent être uniques et forts (min 32 caractères)
SESSION_SECRET=CHANGE_THIS_STRONG_SESSION_SECRET_MIN_32_CHARS
CSRF_SECRET=CHANGE_THIS_STRONG_CSRF_SECRET_MIN_32_CHARS

# ── BASE DE DONNÉES APPLICATION ───────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=logsystem
DB_PASSWORD=CHANGE_THIS_STRONG_APP_PASSWORD_MIN_32_CHARS
DB_NAME=logsystem
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_KEEPALIVE=true

# ── REDIS APPLICATION ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_STRONG_REDIS_PASSWORD_MIN_32_CHARS
REDIS_DB=0

# ── IMPORT & UPLOAD ────────────────────────────────────────────────────────────
UPLOAD_MAX_SIZE=5242880000
IMPORT_BATCH_SIZE=1000

# ── ALERTES & TÂCHES PLANIFIÉES ───────────────────────────────────────────────
ALERT_EVAL_INTERVAL=60000
RETENTION_CRON_HOUR=3

# ── MIGRATIONS & SERVICES ─────────────────────────────────────────────────────
RUN_MIGRATIONS_ON_START=true
START_BACKGROUND_JOBS=true

# ── WATCHER (FILE MONITORING) ────────────────────────────────────────────────
WATCH_DIRS=/app/logs
WATCH_DIR_USER_MAP=/app/logs:1

# ═════════════════════════════════════════════════════════════════════════════
# CHECKLIST AVANT DÉPLOIEMENT:
# ═════════════════════════════════════════════════════════════════════════════
#
# [ ] Tous les mots de passe ont été remplacés par des valeurs fortes
# [ ] Les secrets SESSION_SECRET et CSRF_SECRET sont uniques
# [ ] Les mots de passe MySQL et Redis sont différents
# [ ] Les ports exposés sont corrects pour votre infrastructure
# [ ] Les volumes persistants sont configurés sur stockage durable
# [ ] Les backups automatiques sont configurés
# [ ] Le firewall/restreint l'accès aux ports MySQL et Redis
# [ ] HTTPS est configuré avec reverse proxy (Nginx/Traefik)
# [ ] Les logs sont configurés pour la centralisation
# [ ] Le monitoring et l'alerting sont configurés
#
# ═════════════════════════════════════════════════════════════════════════════
