# ═════════════════════════════════════════════════════════════════════════════
# LogSystem - Docker Environment Configuration Example
# 
# ⚠️ IMPORTANT: Copiez ce fichier en .env.docker et modifiez les secrets
# Pour le développement local, utilisez .env
# ═════════════════════════════════════════════════════════════════════════════

# ─ NODE & APPLICATION ──────────────────────────────────────────────────────────
NODE_ENV=production
PORT=10000
APP_VERSION=6.0.0

# ─ LOGGING ─────────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─ DATABASE - MySQL (Docker) ───────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_USER=logsystem
DB_PASSWORD=CHANGE_THIS_PASSWORD
DB_NAME=logsystem
DB_SSL=false
DB_CONNECTION_LIMIT=10
DB_QUEUE_LIMIT=0

# ─ REDIS (Docker) ──────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_THIS_PASSWORD
REDIS_DB=0

# Optional email delivery (SMTP 587 with STARTTLS or 465 with implicit TLS)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=LogSystem <logs@example.com>

# Optional WhatsApp delivery through Twilio (requires WhatsApp opt-in/session rules)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886

# ─ SECURITY - REQUIRED ────────────────────────────────────────────────────────
# ⚠️ MANDATORY: Ces secrets doivent être uniques pour chaque déploiement
# Générez-les avec: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=CHANGE_THIS_SECRET
CSRF_SECRET=CHANGE_THIS_SECRET

# ─ AUTHENTICATION & SECURITY ──────────────────────────────────────────────────
BCRYPT_ROUNDS=12

# ─ UPLOAD & IMPORT SETTINGS ────────────────────────────────────────────────────
UPLOAD_MAX_FILES=10
IMPORT_BATCH_SIZE=1000
MAX_EXTRACTED_FILES=1000
MAX_ARCHIVE_DEPTH=3

# ─ FILE WATCH & AUTOMATIC LOG IMPORT ──────────────────────────────────────────
WATCH_DIRS=/app/logs
WATCH_DIR_USER_MAP=/app/logs:1

# ─ BACKGROUND JOBS & SERVICES ────────────────────────────────────────────────
START_BACKGROUND_JOBS=true
RUN_MIGRATIONS_ON_START=true

# ─ ALERTING ENGINE ────────────────────────────────────────────────────────────
ALERT_EVAL_INTERVAL=60000
ALERT_DEBOUNCE_MS=2000
SAFETY_INTERVAL=60000

# ─ LOG RETENTION & CLEANUP ────────────────────────────────────────────────────
RETENTION_CRON_HOUR=3

# ─ LOCALE & INTERNATIONALIZATION ───────────────────────────────────────────────
LOG_DATE_LOCALE=fr

# ─ RATE LIMITING ──────────────────────────────────────────────────────────────
IMPORT_RATE_MAX=10
SEARCH_RATE_MAX=100

# ─ DEFAULT USERS (SETUP ONLY) ──────────────────────────────────────────────
DEFAULT_ADMIN_EMAIL=admin@logsystem.local
DEFAULT_ADMIN_PASSWORD=Admin@1234
DEFAULT_ADMIN_NAME=Administrateur
DEFAULT_USER_EMAIL=user@logsystem.local
DEFAULT_USER_PASSWORD=User@1234
DEFAULT_USER_NAME=Utilisateur Standard
